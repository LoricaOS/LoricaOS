/build/
/vendor/
/references/
*.o
*.a
*.elf

# `make selftest` scratch dir (host-built parser regression checks)
/user/bin/herald/.selftest/

# Limine is fetched (pinned in tools/limine/VERSION), not vendored.
/tools/limine/*
!/tools/limine/VERSION

# herald PRIVATE signing key — NEVER commit (public trust anchor trusted_key.h IS committed).
# Rotated 2026-07-09 after the prior key leaked in git history.
/tools/herald-keys/*.key
/build/herald-keys/

# tools/fuzz build products + generated corpora (harnesses/seeds are tracked)
/tools/fuzz/fuzz_manifest
/tools/fuzz/fuzz_tar
/tools/fuzz/fuzz_repo
/tools/fuzz/fuzz_dhcp
/tools/fuzz/tar_pure.o
/tools/fuzz/trusted_key.h
/tools/fuzz/corpus_*/
/tools/fuzz/crash-*
/tools/fuzz/leak-*
/tools/fuzz/timeout-*
/tools/fuzz/oom-*
